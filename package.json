{
  "name": "rbac",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "bun --watch index.ts",
    "dev:frontend": "npm --workspace rbac-client run dev",
    "start": "bun index.ts",
    "build": "npm --workspace rbac-client run build",
    "gen": "DATABASE_URL=\"mysql://avnadmin:AVNS_nYGWUQ2e8YKHr1ut_vu@rbac-mysql-rbac.k.aivencloud.com:11409/defaultdb?ssl-mode=REQUIRED\" bunx prisma generate",
    "seed": "bun prisma/seed.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && npm --workspace rbac-client exec tsc -- --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.2.1",
    "prisma": "^6.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.0.0",
    "axios": "^1.16.1",
    "elysia": "^1.4.28",
    "jsonwebtoken": "^9.0.3"
  }
}
